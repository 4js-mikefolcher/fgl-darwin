SCHEMA northwind

TOOLBAR
  ITEM run
  SEPARATOR
  ITEM exit
END

LAYOUT (TEXT="Orders By Date Range Report")
  VBOX
    GROUP (TEXT="Selection Criteria", STYLE="box")
      GRID
      {
        Order Date:   [orderdate     ]
      }
      END
    END
  END
END

TABLES
  orders
END

ATTRIBUTES
  DATEEDIT orderdate = orders.orderdate;
END

INSTRUCTIONS
  SCREEN RECORD s_criteria(orders.orderdate);
END
