SCHEMA northwind

LAYOUT (TEXT="Orders List View", TAG="list_standard.4tb")
  VBOX
    TABLE (DOUBLECLICK=modify)
    {
     ID     Customer                          Employee                         Order Date Ship Via Freight
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [c1    |c2                               |c3                              |c4        |c5     |c6          ]
    [tcnt  ]                                                                                     [tfrt        ]
    }
    END
  END
END

ATTRIBUTES
  c1 = formonly.orderid TYPE INTEGER, NOENTRY;
  c2 = formonly.customername TYPE VARCHAR, NOENTRY, SCROLL;
  c3 = formonly.employeename TYPE VARCHAR, NOENTRY, SCROLL;
  c4 = formonly.orderdate TYPE DATE, NOENTRY;
  c5 = formonly.shipvia TYPE SMALLINT, NOENTRY;
  c6 = formonly.freight TYPE FLOAT, NOENTRY;

  AGGREGATE tcnt = FORMONLY.rec_count,
    AGGREGATETEXT = "Count:", AGGREGATETYPE = COUNT;
  AGGREGATE tfrt = FORMONLY.freight_total,
    AGGREGATETEXT = "Total:", AGGREGATETYPE = SUM;
END --ATTRIBUTES

INSTRUCTIONS
  SCREEN RECORD orders_list[10](orderid, customername, employeename, orderdate, shipvia, freight);
END
