SCHEMA northwind

TOOLBAR
  ITEM query
  ITEM add
  SEPARATOR
  ITEM first
  ITEM previous
  ITEM next
  ITEM last
  SEPARATOR
  AUTOITEMS (CONTENT=actions)
  SEPARATOR
  ITEM modify
  ITEM delete
  SEPARATOR
  ITEM exit
END

LAYOUT (TEXT="Region Management")
  VBOX
    GROUP (TEXT="Region Information", STYLE="box")
      GRID
      {
        Region ID:    [regionid       ]
        Description:  [regiondescription                         ]
      }
      END
    END
  END
END

ATTRIBUTES
  regionid = FORMONLY.regionid TYPE INTEGER, DEFAULT=0, NOENTRY, TITLE="Region ID";
  regiondescription = formonly.regiondescription TYPE VARCHAR;
END

INSTRUCTIONS
  SCREEN RECORD s_region(formonly.regionid, formonly.regiondescription);
END
