DATABASE northwind

SCREEN SIZE 25 BY 80
{
┌────────────────────────────── Regions ──────────────────────────┐
  Region ID     : [regionid]
  Description   : [regiondescription                             ]



















└──────────────────────────────────────────────────────────────────┘
}
END
ATTRIBUTES
regionid = FORMONLY.regionid TYPE INTEGER, DEFAULT=0, NOENTRY, TITLE="Region ID";
regiondescription = FORMONLY.regiondescription, TITLE="Description";
END
INSTRUCTIONS
SCREEN RECORD s_region(formonly.regionid, formonly.regiondescription);
END
