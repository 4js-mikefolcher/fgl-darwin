SCHEMA northwind

LAYOUT (TEXT="Shippers List View", TAG="list_standard.4tb")
  VBOX
    TABLE (DOUBLECLICK=modify)
    {
     ID  Company Name                             Phone
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    [c1 |c2                                      |c3                      ]
    }
    END
  END
END

ATTRIBUTES
  c1 = formonly.shipperid TYPE INTEGER, NOENTRY;
  c2 = formonly.companyname TYPE VARCHAR, NOENTRY, SCROLL;
  c3 = formonly.phone TYPE VARCHAR, NOENTRY, SCROLL;
END --ATTRIBUTES

INSTRUCTIONS
  SCREEN RECORD shippers_list[10](shipperid, companyname, phone);
END
