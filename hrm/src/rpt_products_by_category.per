SCHEMA northwind

LAYOUT (TEXT="Products by Category Report", TAG="report_criteria.4tb")
  VBOX
    GROUP (TEXT="Selection Criteria", STYLE="box")
      GRID
      {
        Category:     [categoryname                           ]
        Product:      [productname                            ]
      }
      END
    END
  END
END

TABLES
  categories,
  products
END

ATTRIBUTES
  EDIT categoryname = categories.categoryname;
  EDIT productname = products.productname;
END

INSTRUCTIONS
  SCREEN RECORD s_criteria(categories.categoryname, products.productname);
END
