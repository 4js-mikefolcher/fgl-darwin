<?xml version="1.0" encoding="UTF-8"?>
<StyleList>
  <Style name="Window.noaction">
    <StyleAttribute name="actionPanelPosition" value="none" />
    <StyleAttribute name="ringMenuPosition" value="none" />
  </Style>

  <Style name="form">
    <StyleAttribute name="backgroundColor" value="white" />
    <StyleAttribute name="textColor" value="black" />
  </Style>

  <Style name="formField">
    <StyleAttribute name="backgroundColor" value="white" />
    <StyleAttribute name="textColor" value="black" />
  </Style>

  <Style name="label">
    <StyleAttribute name="textColor" value="black" />
    <StyleAttribute name="fontWeight" value="normal" />
  </Style>

  <Style name="button">
    <StyleAttribute name="backgroundColor" value="whitesmoke" />
    <StyleAttribute name="textColor" value="black" />
  </Style>

  <Style name="toolBar">
    <StyleAttribute name="backgroundColor" value="lightgray" />
    <StyleAttribute name="orientation" value="horizontal" />
  </Style>

  <Style name="Window.modulewindow">
    <StyleAttribute name="windowType" value="modal" />
    <StyleAttribute name="actionPanelPosition" value="none" />
    <StyleAttribute name="ringMenuPosition" value="none" />
  </Style>
  <Style name="Window.reportviewer">
    <StyleAttribute name="windowType" value="modal" />
    <StyleAttribute name="actionPanelPosition" value="bottom" />
    <StyleAttribute name="ringMenuPosition" value="bottom" />
    <StyleAttribute name="toolBarPosition" value="none" />
    <StyleAttribute name="fontFamily" value="monospace" />
    <StyleAttribute name="highlightCurrentRow" value="no" />
  </Style>

  <Style name="Table.MenuTree">
     <StyleAttribute name="alternateRows" value="no"/>
     <StyleAttribute name="backgroundColor" value="white" />
     <StyleAttribute name="rowHover" value="yes" />
     <StyleAttribute name="highlightCurrentRow" value="no" />
     <StyleAttribute name="highlightColor" value="#6495ED" />
     <StyleAttribute name="highlightTextColor" value="black" />
     <StyleAttribute name="rowActionTrigger" value="singleClick" />
  </Style>

</StyleList>
