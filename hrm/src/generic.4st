<?xml version="1.0" encoding="UTF-8"?>
<StyleList>
  <Style name="Window.noactions">
    <StyleAttribute name="windowType" value="normal" />
    <StyleAttribute name="actionPanelPosition" value="none" />
    <StyleAttribute name="ringMenuPosition" value="none" />
  </Style>

  <Style name="form">
    <StyleAttribute name="backgroundColor" value="white" />
    <StyleAttribute name="textColor" value="black" />
  </Style>

  <Style name="formField">
    <StyleAttribute name="backgroundColor" value="white" />
    <StyleAttribute name="textColor" value="black" />
  </Style>

  <Style name="label">
    <StyleAttribute name="textColor" value="black" />
    <StyleAttribute name="fontWeight" value="normal" />
  </Style>

  <Style name="button">
    <StyleAttribute name="backgroundColor" value="whitesmoke" />
    <StyleAttribute name="textColor" value="black" />
  </Style>

  <Style name="toolBar">
    <StyleAttribute name="backgroundColor" value="lightgray" />
    <StyleAttribute name="orientation" value="horizontal" />
  </Style>
</StyleList>
