fglform empl_terr.per
if [ $? -eq 0 ]; then
   mv empl_terr.42f ../bin/.
else
   exit -1
fi
fgl2p -o main_empl_terr.42r main_empl_terr.4gl main_lib.4gl empl_terr.4gl territories.4gl employees.4gl region.4gl
if [ $? -eq 0 ]; then
   mv main_empl_terr.42r main_empl_terr.42m main_lib.42m empl_terr.42m territories.42m employees.42m region.42m ../bin/.
else
   exit -1
fi
