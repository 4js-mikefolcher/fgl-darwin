#!/bin/bash

fglform territories.per
if [ $? -eq 0 ]; then
   mv territories.42f ../bin/.
else
   exit -1
fi

fgl2p -o main_territories.42r main_territories.4gl main_lib.4gl territories.4gl region.4gl
if [ $? -eq 0 ]; then
   mv main_territories.42r main_territories.42m main_lib.42m territories.42m region.42m ../bin/.
else
   exit -1
fi
