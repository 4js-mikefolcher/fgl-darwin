SCHEMA northwind

TOOLBAR
  ITEM query
  ITEM add
  SEPARATOR
  ITEM save_master
  SEPARATOR
  ITEM add_detail
  ITEM edit_detail
  ITEM delete_detail
  SEPARATOR
  ITEM exit
END

LAYOUT (TEXT="Master-Detail: Orders with Order Details")
  VBOX
    GROUP (TEXT="Order Information", STYLE="box")
      GRID
      {
        Order ID:       [orderid   ]
        Customer ID:    [customerid          ][customername          ]
        Employee ID:    [employeeid][employeename                    ]
        Order Date:     [orderdt   ]
        Required Date:  [reqireddt ]
        Shipped Date:   [shippeddt ]
        Ship Via:       [shipvia                                     ]
        Freight:        [freight         ]
      }
      END
    END
    GROUP (TEXT="Ship To Information", STYLE="box")
      GRID
      {
        Ship to:        [shipname                              ]
        Address:        [shipaddress                                  ]
        City:           [shipcity        ]
        Region:         [shipregion      ]
        Postal Code:    [shippostal]
        Country:        [shipcountry     ]
      }
      END
    END
    GROUP (TEXT="Order Detail Lines", STYLE="box")
      TABLE
      {
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
        [productid][productname                              ][unitprice       ][quantity  ][discount       ]
      }
      END
    END
  END
END

TABLES
  orders
  order_details
  customers
  employees
  products
END

ATTRIBUTES

  orderid = formonly.orderid TYPE INTEGER, DEFAULT=0, NOENTRY;
  BUTTONEDIT customerid = formonly.customerid TYPE CHAR, ACTION=zoom_customer;
  customername = formonly.customername, NOENTRY;
  BUTTONEDIT employeeid = formonly.employeeid TYPE SMALLINT, ACTION=zoom_employee;
  employeename = formonly.employeename TYPE CHAR, NOENTRY;
  DATEEDIT orderdt = formonly.orderdate TYPE DATE;
  DATEEDIT reqireddt = formonly.requireddate TYPE DATE;
  DATEEDIT shippeddt = formonly.shippeddate TYPE DATE;
  COMBOBOX shipvia = formonly.shipvia TYPE SMALLINT;
  freight = formonly.freight TYPE FLOAT;
  shipname = formonly.shipname TYPE VARCHAR;
  shipaddress = formonly.shipaddress TYPE VARCHAR;
  shipcity = formonly.shipcity TYPE VARCHAR;
  shipregion = formonly.shipregion TYPE VARCHAR;
  shippostal = formonly.shippostalcode TYPE VARCHAR;
  shipcountry = formonly.shipcountry TYPE VARCHAR;

  EDIT productid = formonly.productid TYPE SMALLINT, TITLE="Product ID";
  EDIT productname = formonly.productname TYPE VARCHAR, NOENTRY, SCROLL, TITLE="Product Name";
  EDIT unitprice = formonly.unitprice TYPE FLOAT, TITLE="Unit Price";
  EDIT quantity = formonly.quantity TYPE SMALLINT, TITLE="Quantity";
  EDIT discount = formonly.discount TYPE FLOAT, TITLE="Discount";

END

INSTRUCTIONS

  SCREEN RECORD s_orders(formonly.orderid, formonly.customerid,
    formonly.customername, formonly.employeeid, formonly.employeename,
    formonly.orderdate, formonly.requireddate, formonly.shippeddate,
    formonly.shipvia, formonly.freight,
    formonly.shipname, formonly.shipaddress, formonly.shipcity,
    formonly.shipregion, formonly.shippostalcode, formonly.shipcountry);

  SCREEN RECORD sr_order_details(formonly.productid, formonly.productname,
    formonly.unitprice, formonly.quantity, formonly.discount);

END
