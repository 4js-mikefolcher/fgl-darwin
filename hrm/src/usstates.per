SCHEMA northwind

LAYOUT (TEXT="US States Management", TAG="detail_standard.4tb")
  VBOX
    GROUP (TEXT="State Information", STYLE="box")
      GRID
      {
        State ID:      [stateid      ]
        State Name:    [statename                                     ]
        Abbreviation:  [stateabbr]
        Region:        [stateregion                          ]
      }
      END
    END
  END
END

ATTRIBUTES
  stateid = formonly.stateid TYPE INTEGER, DEFAULT=0, NOENTRY;
  statename = formonly.statename TYPE VARCHAR;
  stateabbr = formonly.stateabbr TYPE VARCHAR;
  stateregion = formonly.stateregion TYPE VARCHAR;
END --ATTRIBUTES

INSTRUCTIONS
  SCREEN RECORD s_usstates(formonly.stateid, formonly.statename, formonly.stateabbr, formonly.stateregion);
END
