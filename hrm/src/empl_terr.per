{
["Employee ID"]["Employee Name     "]["Territory ID"]["Territory Name    "]["Region Name      "]
[employeeid   ][fullname            ][territoryid   ][territorydescription][regiondescription  ]
[employeeid   ][fullname            ][territoryid   ][territorydescription][regiondescription  ]
