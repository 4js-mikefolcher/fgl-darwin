[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]








└──────────────────────────────────────────────────────────────────────────┘
}

END --SCREEN

TABLES
   employees
   territories
   region
   employeeterritories

END --TABLES

ATTRIBUTES

   emplid = employeeterritories.employeeid;
   fullname = formonly.fullname, NOENTRY;
   terrid = employeeterritories.territoryid;
   territorydescription = territories.territorydescription, NOENTRY;
   regiondesc = region.regiondescription, NOENTRY;

END --ATTRIBUTES

INSTRUCTIONS

   SCREEN RECORD sa_empl_terr[10](employeeterritories.employeeid THRU region.regiondescription);

END --INSTRUCTIONS
