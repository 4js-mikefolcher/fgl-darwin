SCHEMA northwind

LAYOUT (TEXT="Employee Territories", TAG="detail_no_modify.4tb")
  VBOX
    GROUP (TEXT="Employee Territory Assignment", STYLE="box")
      GRID
      {
        Employee ID:            [emplid          ]
        Employee Name:          [fullname                              ]
        Territory ID:           [terrid           ]
        Territory Description:  [territorydescription                  ]
        Region:                 [regiondesc                            ]
      }
      END
    END
  END
END

ATTRIBUTES
  BUTTONEDIT emplid = formonly.employeeid TYPE SMALLINT, ACTION=zoom_employee;
  fullname = formonly.fullname TYPE VARCHAR, NOENTRY;
  BUTTONEDIT terrid = formonly.territoryid TYPE VARCHAR, ACTION=zoom_territory;
  territorydescription = formonly.territorydescription TYPE VARCHAR, NOENTRY;
  regiondesc = formonly.regiondescription TYPE VARCHAR, NOENTRY;
END

INSTRUCTIONS
  SCREEN RECORD s_empl_terr(
    formonly.employeeid,
    formonly.fullname,
    formonly.territoryid,
    formonly.territorydescription,
    formonly.regiondescription);
END
