DATABASE northwind

SCREEN SIZE 25 BY 80
{
┌───────────────────────── Employee Territories ──────────────────────────┐
["Empl ID"]["Employee Name     "]["Terr ID"]["Territory Name    "]["Region"]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
[emplid   ][fullname            ][terrid   ][territorydescription][regiondesc]
