SCHEMA northwind

LAYOUT (TEXT="Customer Demographics Management", TAG="detail_cust_demo.4tb")
  VBOX
    GROUP (TEXT="Customer Demographic Information", STYLE="box")
      GRID
      {
        Customer Type ID:   [customertypeid                ]
        Type Description:   [customerdesc                                    ]
                            [                                                ]
                            [                                                ]
                            [                                                ]
      }
      END
    END
  END
END

ATTRIBUTES
  customertypeid = formonly.customertypeid TYPE CHAR;
  TEXTEDIT customerdesc = formonly.customerdesc TYPE VARCHAR;
END --ATTRIBUTES

INSTRUCTIONS
  SCREEN RECORD s_cust_demo(formonly.customertypeid, formonly.customerdesc);
END
