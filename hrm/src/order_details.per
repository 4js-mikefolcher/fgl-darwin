SCHEMA northwind

TOOLBAR
  ITEM query
  ITEM add
  SEPARATOR
  ITEM first
  ITEM previous
  ITEM next
  ITEM last
  SEPARATOR
  AUTOITEMS (CONTENT=actions)
  SEPARATOR
  ITEM list
  SEPARATOR
  ITEM modify
  ITEM delete
  SEPARATOR
  ITEM exit
END

LAYOUT (TEXT="Order Details")
  VBOX
    GROUP (TEXT="Order Detail Information", STYLE="box")
      GRID
      {
        Order ID:        [orderid   ]
        Product ID:      [productid ][productname                         ]
        Unit Price:      [unitprice      ]
        Quantity:        [quantity  ]
        Discount Factor: [discount       ]
        Total Price:     [totalprice     ]
      }
      END
    END
  END
END

ATTRIBUTES
  BUTTONEDIT orderid = formonly.orderid TYPE SMALLINT, ACTION=zoom_order;
  BUTTONEDIT productid = formonly.productid TYPE SMALLINT, ACTION=zoom_product;
  productname = formonly.productname TYPE VARCHAR, NOENTRY;
  unitprice = formonly.unitprice TYPE DECIMAL(10,2), FORMAT="$###,##&.&&";
  quantity = formonly.quantity TYPE SMALLINT;
  discount = formonly.discount TYPE DECIMAL(10,8);
  totalprice = formonly.totalprice TYPE DECIMAL(10,2), FORMAT="$###,##&.&&", NOENTRY;
END

INSTRUCTIONS
  SCREEN RECORD s_order_details(formonly.orderid, formonly.productid,
    formonly.productname, formonly.unitprice,
    formonly.quantity, formonly.discount, formonly.totalprice);
END
