SCHEMA northwind

LAYOUT (TEXT="Territories Management", TAG="detail_standard.4tb")
  VBOX
    GROUP (TEXT="Territory Information", STYLE="box")
      GRID
      {
        Territory ID: [territoryid              ]
        Description:  [territorydescription      ]
        Region:       [regionid                              ]
      }
      END
    END
  END
END

ATTRIBUTES
  territoryid = formonly.territoryid TYPE VARCHAR;
  territorydescription = formonly.territorydescription TYPE VARCHAR;
  COMBOBOX regionid = formonly.regionid TYPE SMALLINT;
END

INSTRUCTIONS
  SCREEN RECORD s_territories(formonly.territoryid, formonly.territorydescription,
                              formonly.regionid);
END
