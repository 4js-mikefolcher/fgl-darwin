SCHEMA northwind

LAYOUT (TEXT="Categories Management", TAG="detail_with_products.4tb")
  VBOX
    GROUP (TEXT="Category Information", STYLE="box")
      GRID
      {
        Category ID:   [categoryid      ]
        Name:          [categoryname         ]
        Description:   [description                         ]
                       [                                    ]
                       [                                    ]
                       [                                    ]
      }
      END
    END
  END
END

ATTRIBUTES
  categoryid = formonly.categoryid TYPE INTEGER, DEFAULT=0, NOENTRY;
  categoryname = formonly.categoryname TYPE VARCHAR;
  TEXTEDIT description = formonly.description TYPE VARCHAR;
END --ATTRIBUTES

INSTRUCTIONS
  SCREEN RECORD s_categories(formonly.categoryid, formonly.categoryname, formonly.description);
END
