SCHEMA northwind

TOOLBAR
  ITEM query
  ITEM add
  SEPARATOR
  ITEM first
  ITEM previous
  ITEM next
  ITEM last
  SEPARATOR
  AUTOITEMS (CONTENT=actions)
  SEPARATOR
  ITEM modify
  ITEM delete
  ITEM products
  SEPARATOR
  ITEM exit
END

LAYOUT (TEXT="Categories Management")
  VBOX
    GROUP (TEXT="Category Information", STYLE="box")
      GRID
      {
        Category ID:   [categoryid      ]
        Name:          [categoryname         ]
        Description:   [description                         ]
                       [                                    ]
                       [                                    ]
                       [                                    ]
      }
      END
    END
  END
END

ATTRIBUTES
  categoryid = formonly.categoryid TYPE SMALLINT;
  categoryname = formonly.categoryname TYPE VARCHAR;
  TEXTEDIT description = formonly.description TYPE VARCHAR;
END

INSTRUCTIONS
  SCREEN RECORD s_categories(formonly.categoryid, formonly.categoryname, formonly.description);
END